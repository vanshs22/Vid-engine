  "lines": [
    { "id": "line-01", "text": "A good AI video starts before the first frame is rendered.", "caption": "START BEFORE THE *FRAME", "sceneId": "demo-01", "gapSeconds": 0.25 },
    { "id": "line-02", "text": "You give the director a topic, a style, and an audience.", "caption": "TOPIC STYLE *AUDIENCE", "sceneId": "demo-02", "gapSeconds": 0.25 },
    { "id": "line-03", "text": "The research agent finds useful facts and current examples.", "caption": "FIND THE *FACTS", "sceneId": "demo-03", "gapSeconds": 0.25 },
    { "id": "line-04", "text": "The script writer turns those facts into a clear story.", "caption": "WRITE THE *STORY", "sceneId": "demo-04", "gapSeconds": 0.25 },
    { "id": "line-05", "text": "The scene director chooses a screen, a character action, or a diagram.", "caption": "CHOOSE THE RIGHT *VISUAL", "sceneId": "demo-05", "gapSeconds": 0.25 },
    { "id": "line-06", "text": "Kokoro creates the voice, while Whisper aligns every word.", "caption": "ALIGN EVERY *WORD", "sceneId": "demo-06", "gapSeconds": 0.25 },
    { "id": "line-07", "text": "Remotion and Three.js turn that plan into moving scenes.", "caption": "MAKE IT *MOVE", "sceneId": "demo-07", "gapSeconds": 0.25 },
    { "id": "line-08", "text": "Finally, quality control checks the video before you post it.", "caption": "CHECK BEFORE YOU *POST", "sceneId": "demo-08", "gapSeconds": 0.4 }
  ],
