  "lines": [
    { "id": "line-01", "text": "Most voice cloning demos make the technology look like magic.", "caption": "VOICE CLONING LOOKS LIKE *MAGIC", "sceneId": "accept-01", "gapSeconds": 0.3 },
    { "id": "line-02", "text": "The real workflow is simpler, and it can run on your own computer.", "caption": "RUN IT ON YOUR *COMPUTER", "sceneId": "accept-02", "gapSeconds": 0.3 },
    { "id": "line-03", "text": "First, download a voice model once instead of paying for every minute.", "caption": "DOWNLOAD IT *ONCE", "sceneId": "accept-03", "gapSeconds": 0.3 },
    { "id": "line-04", "text": "Then record a clean sample with a real microphone.", "caption": "RECORD A CLEAN *SAMPLE", "sceneId": "accept-04", "gapSeconds": 0.3 },
    { "id": "line-05", "text": "The model studies the rhythm, pitch, and texture inside that recording.", "caption": "RHYTHM, PITCH, AND *TEXTURE", "sceneId": "accept-05", "gapSeconds": 0.3 },
    { "id": "line-06", "text": "You can then adjust accent, age, emotion, and speaking speed.", "caption": "ADJUST THE *SOUND", "sceneId": "accept-06", "gapSeconds": 0.3 },
    { "id": "line-07", "text": "Type a script, and the system turns those words into narration.", "caption": "WORDS BECOME *NARRATION", "sceneId": "accept-07", "gapSeconds": 0.3 },
    { "id": "line-08", "text": "Whisper can align every spoken word so captions follow the real audio.", "caption": "ALIGN EVERY *WORD", "sceneId": "accept-08", "gapSeconds": 0.3 },
    { "id": "line-09", "text": "Music, whooshes, clicks, and small impacts make the edit feel alive.", "caption": "MAKE THE EDIT FEEL *ALIVE", "sceneId": "accept-09", "gapSeconds": 0.3 },
    { "id": "line-10", "text": "The best scenes show the action instead of repeating one generic panel.", "caption": "SHOW THE *ACTION", "sceneId": "accept-10", "gapSeconds": 0.3 },
    { "id": "line-11", "text": "Use your own voice, or get permission before cloning anyone else.", "caption": "GET *PERMISSION", "sceneId": "accept-11", "gapSeconds": 0.4 }
  ],
