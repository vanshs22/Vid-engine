    { "id": "line-03", "text": "Download the voice model once, then keep it local.", "caption": "DOWNLOAD IT *ONCE", "sceneId": "voice-03", "gapSeconds": 0.24 },
    { "id": "line-04", "text": "Record ten seconds to clone your own voice.", "caption": "CLONE YOUR *VOICE", "sceneId": "voice-04", "gapSeconds": 0.24 },
    { "id": "line-05", "text": "Or design a voice with accent, age, pitch, and speed.", "caption": "DESIGN THE *SOUND", "sceneId": "voice-05", "gapSeconds": 0.24 },
    { "id": "line-06", "text": "Type the script, then generate a clean audio file.", "caption": "TYPE AND *GENERATE", "sceneId": "voice-06", "gapSeconds": 0.24 },
    { "id": "line-07", "text": "Your captions can follow the real words, not guesses.", "caption": "SYNC THE *WORDS", "sceneId": "voice-07", "gapSeconds": 0.24 },
    { "id": "line-08", "text": "Use only voices you own or have permission to use.", "caption": "GET *PERMISSION", "sceneId": "voice-08", "gapSeconds": 0.4 }
